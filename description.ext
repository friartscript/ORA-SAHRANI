// ============================================================================
// MISSION: ORA - Air Force (Sahrani)
// DESCRIPTION: Fichier de configuration principal de la mission
// ============================================================================

author          = "ORA Command";
onLoadName      = "$STR_ORA_Mission_Title";
onLoadMission   = "$STR_ORA_Mission_Subtitle";
overviewText    = "$STR_ORA_Mission_Desc";

briefing        = 1;
debriefing      = 1;
saving          = 1;

// Configuration Solo
respawn         = 0;
respawnTemplates[] = {"None"};
disabledAI      = 1;
enableDebugConsole = 1;

class Header
{
    gameType    = Single;
    minPlayers  = 1;
    maxPlayers  = 1;
};

// ============================================================================
// LIBRAIRIE MODULAIRE DE FONCTIONS (CfgFunctions)
// ============================================================================
class CfgFunctions
{
    class ORA
    {
        tag = "ORA";

        class Core
        {
            file = "Functions\Core";
            class initMission       { compileFinal = 1; };
            class radioMsg          { compileFinal = 1; };
        };

        class Flight
        {
            file = "Functions\Flight";
            class flightEffects         { compileFinal = 1; };
            class ejectionSystem        { compileFinal = 1; };
            class cockpitEgressForfeit  { compileFinal = 1; };
            class weaponGuidance        { compileFinal = 1; };
            class airRefuel             { compileFinal = 1; };
        };

        class Player
        {
            file = "Functions\Player";
            class initLocal         { compileFinal = 1; };
            class setupBriefing     { compileFinal = 1; };
            class cockpitImmersion  { compileFinal = 1; };
            class initLoadout       { compileFinal = 1; };
            class applyLoadout      { compileFinal = 1; };
            class initIdentity      { compileFinal = 1; };
        };

        class Briefing
        {
            file = "Functions\Briefing";
            class initBriefing      { compileFinal = 1; };
            class initContext       { compileFinal = 1; };
        };

        class Environment
        {
            file = "Functions\Environment";
            class randomWeather     { compileFinal = 1; };
            class initSkills        { compileFinal = 1; };
            class applyRACSLoadout  { compileFinal = 1; };
            class preventWater      { compileFinal = 1; };
        };

        class UI
        {
            file = "Functions\UI";
            class mainMenu          { compileFinal = 1; };
        };

        class Task
        {
            file = "Functions\Task";
            class taskLaunch        { compileFinal = 1; };
            class taskGround        { compileFinal = 1; };
            class taskSea           { compileFinal = 1; };
            class taskAir           { compileFinal = 1; };
            class taskHeli          { compileFinal = 1; };
        };
    };
};

// ============================================================================
// INSIGNES ET PATCHES MILITAIRES (CfgUnitInsignia)
// ============================================================================
class CfgUnitInsignia
{
    class RACS_Badge
    {
        displayName = "Royal Army Corps of Sahrani";
        author      = "ORA Air Force";
        texture     = "Images\racs_badge_ca.paa";
        textureVehicle = "";
    };
};

