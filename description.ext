    class ORA_Warning_Beep
    {
        name = "ORA_Warning_Beep";
        sound[] = {"\A3\Sounds_F\sfx\alarm_car.wss", 1.0, 1.2};
        titles[] = {};
    };
};

// ============================================================================
// DÉBRIEFINGS ET FINS DE MISSION (CfgDebriefing)
// ============================================================================
