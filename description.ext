{
    class EndSuccess
    {
        title       = "$STR_ORA_Debrief_Success_Title";
        subtitle    = "$STR_ORA_Debrief_Success_Subtitle";
        description = "$STR_ORA_Debrief_Success_Desc";
        pictureBackground = "";
        picture     = "b_air";
        pictureColor[] = {0.0, 0.6, 0.0, 1};
    };

    class EndKilled
    {
        title       = "$STR_ORA_Debrief_Killed_Title";
        subtitle    = "$STR_ORA_Debrief_Killed_Subtitle";
        description = "$STR_ORA_Debrief_Killed_Desc";
        pictureBackground = "";
        picture     = "KIA";
        pictureColor[] = {0.8, 0.0, 0.0, 1};
    };

    class EndPlaneLost
    {
        title       = "$STR_ORA_Debrief_Lost_Title";
        subtitle    = "$STR_ORA_Debrief_Lost_Subtitle";
        description = "$STR_ORA_Debrief_Lost_Desc";
        pictureBackground = "";
        picture     = "o_air";
        pictureColor[] = {0.8, 0.4, 0.0, 1};
    };

    class EndCockpitForfeit
    {
        title       = "$STR_ORA_Debrief_CockpitForfeit_Title";
        subtitle    = "$STR_ORA_Debrief_CockpitForfeit_Subtitle";
        description = "$STR_ORA_Debrief_CockpitForfeit_Desc";
        pictureBackground = "";
        picture     = "KIA";
        pictureColor[] = {0.9, 0.1, 0.1, 1};
    };
